# ====================================================================
# ShopBuddy AI - Local Sandbox Environment Configuration (2026)
# ====================================================================

# Application Environment Mode (development / production)
APP_ENV=development

# Simulated Free/Paid Gateway Switch (set to true to test the upgrade alert)
SIMULATE_PAID_GATEWAY=false

# --- Stripe API Credentials ---
# Test API Key (Completely free sandbox key provided by Stripe Dashboard)
STRIPE_TEST_SECRET_KEY=sk_test_51P...YourActualFreeStripeTestKey

# Live Production API Key (DO NOT commit to code. Leave blank for free prototyping)
STRIPE_LIVE_SECRET_KEY=

# --- Advanced Configurations (Optional overrides) ---
# CUSTOM_CHROMA_DB_PATH=./alternative_db_storage
